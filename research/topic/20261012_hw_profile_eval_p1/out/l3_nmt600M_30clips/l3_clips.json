[{"seg_id": "8407_40837_0.00_15.28", "ja_ref": "今日はほとんど忘れていなかった、蒸気ガスパッケージを紹介します", "ko_ref": "오늘은 거의 잊지 않았던 증기가스 패키지를 소개하겠습니다.", "t_start": 0.07239340001251549, "t_end": 15.344676200009417}, {"seg_id": "8407_40837_106.28_108.28", "ja_ref": "おっと、おぶさんありがとう", "ko_ref": "이런, 아저씨 고마워요", "t_start": 16.348993699997663, "t_end": 18.33619300002465}, {"seg_id": "8407_40837_108.28_114.28", "ja_ref": "久しぶりの寿司だよ、いつぶり?半年くらい?めっちゃ久しぶり", "ko_ref": "오랜만에 초밥이야, 얼마만이야?반년정도? 정말 오랜만이야.", "t_start": 19.371491300000343, "t_end": 25.34176949999528}, {"seg_id": "8407_40837_116.28_119.28", "ja_ref": "ライブ初参戦、日生さん、よいよいよい", "ko_ref": "라이브 첫 참전, 닛세이씨, 좋아요이", "t_start": 26.352700300049037, "t_end": 29.344109900004696}, {"seg_id": "8407_40837_120.28_122.28", "ja_ref": "トモさんありがとう、一万人", "ko_ref": "토모씨 고마워요, 만명", "t_start": 30.348840399994515, "t_end": 32.33214489999227}, {"seg_id": "8407_40837_129.28_138.28", "ja_ref": "こんばんは、あしゅあしゅさん", "ko_ref": "안녕하세요, 아슈아슈씨", "t_start": 33.379436300019734, "t_end": 42.33440029999474}, {"seg_id": "8407_40837_171.28_178.28", "ja_ref": "30皿がお寿司で10皿がデザート", "ko_ref": "30접시가 초밥이고 10접시가 디저트", "t_start": 43.36706250003772, "t_end": 50.334036400017794}, {"seg_id": "8407_40837_178.28_181.28", "ja_ref": "だからワンチャンいけるかなって感じ", "ko_ref": "그래서 왕창 갈 수 있지 않을까 하는 느낌", "t_start": 51.35767140000826, "t_end": 54.34257550002076}, {"seg_id": "8407_40837_185.28_194.28", "ja_ref": "つまみ食い、もう始めてもいいかな", "ko_ref": "안주 먹고 이제 시작해도 될까", "t_start": 55.362876099999994, "t_end": 64.3419220999931}, {"seg_id": "8407_40837_212.28_219.28", "ja_ref": "じゃあ今からね、体重測定から始めますね、何キロ増えるのか", "ko_ref": "그럼 지금부터 체중 측정부터 시작할게요, 몇 킬로그램 늘어나는지", "t_start": 65.35198610002408, "t_end": 72.34119410003768}, {"seg_id": "8407_40837_231.28_237.28", "ja_ref": "あれ、消えた、待って待ってもう一回", "ko_ref": "어, 꺼졌어, 잠깐만, 잠깐만 다시", "t_start": 73.36258519999683, "t_end": 79.33475780003937}, {"seg_id": "8407_40837_259.28_267.28", "ja_ref": "全然見えんかった、えっとねー体重は54.5、この服を着て54.5です", "ko_ref": "전혀 보이지 않았다. 음.. 몸무게는 54.5 이 옷을 입고 54.5 입니다.", "t_start": 80.38136330002453, "t_end": 88.33618810004555}, {"seg_id": "8407_40837_267.28_271.28", "ja_ref": "はい、皆さん覚えていてください、どんぐらい増えるかな", "ko_ref": "네, 여러분 기억하세요, 얼마나 늘어날까", "t_start": 89.34723340003984, "t_end": 93.34721640002681}, {"seg_id": "8407_40837_285.28_291.28", "ja_ref": "え、じゃあ俺も一回毎日大食いしてみようかな", "ko_ref": "어, 그럼 나도 한번 매일 대식해볼까?", "t_start": 94.36705510003958, "t_end": 100.3445592999924}, {"seg_id": "8407_40837_297.28_301.28", "ja_ref": "マジでもっと大きくなりたかった", "ko_ref": "정말로 더 크고 싶었다.", "t_start": 101.35608630004572, "t_end": 105.33240370004205}, {"seg_id": "8407_40837_304.28_308.28", "ja_ref": "よし、54.5、みんな覚えててね、ほんと", "ko_ref": "좋아, 54.5 모두 기억해, 정말", "t_start": 106.36226670001633, "t_end": 110.33959839999443}, {"seg_id": "8407_40837_322.28_325.28", "ja_ref": "ふーてらのてらは、めしてらのてら!", "ko_ref": "후테라노테라는 메시라노테라!", "t_start": 111.34880120004527, "t_end": 114.3324993000133}, {"seg_id": "8407_40837_325.28_330.28", "ja_ref": "ということで、今日はお寿司100貫を食べていこうと思います", "ko_ref": "그래서 오늘은 초밥 100관을 먹고 가려고 합니다.", "t_start": 115.36671220004791, "t_end": 120.34751480002888}, {"seg_id": "8407_40837_330.28_333.28", "ja_ref": "それでは食べていきましょう", "ko_ref": "그럼 먹고 갑시다", "t_start": 121.35462820000248, "t_end": 124.33431980002206}, {"seg_id": "8407_40837_355.28_359.28", "ja_ref": "そう、めっちゃ小柄なんですよ", "ko_ref": "맞아요, 엄청 작아요.", "t_start": 125.36501130001852, "t_end": 129.33269080001628}, {"seg_id": "8407_40837_377.28_382.28", "ja_ref": "この挨拶、特に意味はないかな", "ko_ref": "이 인사, 특별한 의미는 없을까?", "t_start": 130.3673545999918, "t_end": 135.34264869999606}, {"seg_id": "8407_40837_382.28_386.28", "ja_ref": "なんか先輩が、なんかこんなのもいいねみたいな", "ko_ref": "뭔가 선배님이 뭔가 이런 것도 좋네 이런 것도 좋아요.", "t_start": 136.35752910003066, "t_end": 140.3447451000102}, {"seg_id": "8407_40837_386.28_389.28", "ja_ref": "で、一緒に考えた、やったっけな、どうやったっけ", "ko_ref": "그래서 같이 생각했어, 했지, 어떻게 했지?", "t_start": 141.35677620000206, "t_end": 144.33475040004123}, {"seg_id": "8407_40837_398.28_401.28", "ja_ref": "総額ね、5000円くらいですね", "ko_ref": "총액은 5000엔 정도군요.", "t_start": 145.362307900039, "t_end": 148.34355200000573}, {"seg_id": "8407_40837_401.28_412.28", "ja_ref": "何のネタか、そりゃあね、一番大好きな穴子からで決めてた", "ko_ref": "무슨 소재인지, 그거야, 제일 좋아하는 붕장어부터 정했어.", "t_start": 149.38275240000803, "t_end": 160.33519610000076}, {"seg_id": "8407_40837_430.28_435.28", "ja_ref": "米田はね、明日動画上げるのでお楽しみに", "ko_ref": "요네다는 내일 동영상 올리니까 기대해주세요.", "t_start": 161.36551220004912, "t_end": 166.33751850004774}, {"seg_id": "8407_40837_456.28_460.28", "ja_ref": "今日はお寿司だけ一応、でも一応ね", "ko_ref": "오늘은 초밥만 일단, 그래도 일단은..", "t_start": 167.36026899999706, "t_end": 171.33737950003706}, {"seg_id": "8407_40837_460.28_465.28", "ja_ref": "あの、もし全部食べきれたらプリンが1個あります", "ko_ref": "저기, 만약 다 먹으면 푸딩이 1개 있어요.", "t_start": 172.35320730000967, "t_end": 177.3365022999933}, {"seg_id": "8407_40837_470.28_474.28", "ja_ref": "ね、米田マジで楽しみにしてて、めっちゃ", "ko_ref": "있잖아, 요네다 정말로 기대하고 있어, 굉장히", "t_start": 178.3571766000241, "t_end": 182.34650159999728}, {"seg_id": "8407_40837_482.28_487.28", "ja_ref": "陸上のね、長距離1500とかやってるかな", "ko_ref": "육상에서 장거리 1500 이런거 하고 있을까?", "t_start": 183.36900470004184, "t_end": 188.33722560002934}]